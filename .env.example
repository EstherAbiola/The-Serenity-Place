# Copy these into GoDaddy Node.js Hosting → Settings → Secrets. Never commit real values.

# Postgres connection (Neon). Without it the app uses a temporary in-memory database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random string used to sign staff/owner logins (e.g. 64 random characters).
SESSION_SECRET=change-me

# First owner login, created on first start if it doesn't exist yet.
OWNER_NAME=Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me

# Paystack secret key. Leave unset for preview mode (no money taken).
# Use sk_test_... to test with Paystack test cards, then sk_live_... for real payments.
PAYSTACK_SECRET_KEY=

# Optional: the site's public address, used for the Paystack return link (e.g. https://serenityplace.ng).
PUBLIC_URL=
