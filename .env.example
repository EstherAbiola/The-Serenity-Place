# All settings are OPTIONAL. The app runs without any of them.
# On GoDaddy they go under Settings → Secrets. Never commit real values.

# Keep data permanently in Neon Postgres. Without it, data resets when the app restarts.
DATABASE_URL=

# Long random string so staff stay logged in across restarts.
SESSION_SECRET=

# Create the owner login on start (alternative to the one-time setup code in the logs).
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# Team inbox for alerts about new reservations and job applications.
NOTIFY_EMAIL=

# Shown at the bottom of emails to guests and staff.
CONTACT_PHONE=
CONTACT_ADDRESS=

# Optional: send emails through Resend instead of GoDaddy's built-in gateway.
# Until you verify a domain in Resend, it only delivers to your own Resend login email.
RESEND_API_KEY=
# After verifying your domain in Resend, e.g. Serenity Place <bookings@yourdomain.com>
EMAIL_FROM=
# Where guest replies go, e.g. your bookings inbox
EMAIL_REPLY_TO=
